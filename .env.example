# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Upload policy
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.docx,.xlsx
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# PostgreSQL (required in production; leave unset for local foundation work)
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# RabbitMQ (required in production; retry count is fixed at 3)
RABBITMQ_URL=
RABBITMQ_EXCHANGE=document-ingestion
RABBITMQ_QUEUE=document-processing
RABBITMQ_ROUTING_KEY=document.process
RABBITMQ_RETRY_COUNT=3
RABBITMQ_RETRY_BASE_DELAY_SECONDS=1
RABBITMQ_RETRY_MAX_DELAY_SECONDS=60
RABBITMQ_RETRY_JITTER=false
RABBITMQ_DLQ_EXCHANGE=document-ingestion-dlx
RABBITMQ_DLQ_QUEUE=document-processing-dlq
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10

# Firebase (required in production; leave unset for local foundation work)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# Application authentication (required in production)
JWT_SIGNING_KEY=
AUTH_ISSUER=legal-document-intelligence-platform
AUTH_AUDIENCE=legal-document-intelligence-platform-api
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# Artifact storage (filesystem for local development/CI; Firebase in production)
STORAGE_BACKEND=filesystem
STORAGE_ROOT=.data/artifacts
